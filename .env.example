# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
PROJECT_NAME="KLS Academy API"
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database
#
# Local development — a Postgres running on this machine:
DATABASE_URL=postgresql+psycopg://kls:kls_dev_password@localhost:5432/kls_academy
#
# Supabase — use the SHARED POOLER, not the direct connection. The direct
# host (db.<ref>.supabase.co) resolves to IPv6 only, and most VPS providers
# give you an IPv4 address, so it simply will not connect. The pooler answers
# on IPv4 on every plan.
#
#   The app (session mode, port 5432):
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Port 6543 is transaction mode. Do not point the app or Alembic at it: it
# shares one backend between clients between statements, so prepared
# statements, SET, advisory locks and LISTEN/NOTIFY stop behaving. Migrations
# in particular want a real session.
#
# `sslmode=require` is not optional for anything remote. Without it psycopg
# will connect in clear text if the server permits, and every row crosses the
# internet in the open. The app refuses to start in production without it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# CORS — the two frontends
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://academy.klstechsolutions.in,https://admin.klstechsolutions.in

# ---------------------------------------------------------------------------
# Storage — screenshots, offer letters, certificates, chapter notes
#
# Files are written to this directory on local disk. There is no object store:
# **this folder is the only copy of every student document.**
#
# In production set an absolute path OUTSIDE the code directory, e.g.
# /srv/kls/media. A redeploy replaces the code tree, and a media folder inside
# it would go too. It must also be in the backup — see docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
MEDIA_ROOT=media

# ---------------------------------------------------------------------------
# Age policy
#
# The DPDP Act 2023 treats under-18s as children and requires verifiable
# parental consent to process their data. We collect no such consent, so
# registration refuses anyone below this age. Only lower it once a consent
# flow exists.
# ---------------------------------------------------------------------------
MINIMUM_AGE=18

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="KLS Academy <noreply@klstechsolutions.in>"

# ---------------------------------------------------------------------------
# Public URLs — used in emails and QR codes
# ---------------------------------------------------------------------------
ACADEMY_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# First super admin, created by scripts/seed.py
# ---------------------------------------------------------------------------
FIRST_SUPERADMIN_EMAIL=admin@klstechsolutions.in
# Required before seeding — there is no default. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
FIRST_SUPERADMIN_PASSWORD=
