# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
PROJECT_NAME="KLS Academy API"
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database
# Inside docker compose the host is the service name: "db".
# Running the API outside docker against the compose Postgres: use localhost.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://kls:kls_dev_password@db:5432/kls_academy

# ---------------------------------------------------------------------------
# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# CORS — the two frontends
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://academy.klstechsolutions.in,https://admin.klstechsolutions.in

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible) — screenshots, offer letters, certificates
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kls-academy
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Age policy
#
# The DPDP Act 2023 treats under-18s as children and requires verifiable
# parental consent to process their data. We collect no such consent, so
# registration refuses anyone below this age. Only lower it once a consent
# flow exists.
# ---------------------------------------------------------------------------
MINIMUM_AGE=18

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="KLS Academy <noreply@klstechsolutions.in>"

# ---------------------------------------------------------------------------
# Public URLs — used in emails and QR codes
# ---------------------------------------------------------------------------
ACADEMY_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# First super admin, created by scripts/seed.py
# ---------------------------------------------------------------------------
FIRST_SUPERADMIN_EMAIL=admin@klstechsolutions.in
# Required before seeding — there is no default. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
FIRST_SUPERADMIN_PASSWORD=
